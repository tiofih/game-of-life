static func offsets_from_art(art: Array) -> Array[Vector2i]:
	var out: Array[Vector2i] = []
	for y in art.size():
		var line: String = art[y]
		for x in line.length():
			if line[x] == "#":
				out.append(Vector2i(x, y))
	return out
